# === BASE DE DONNÉES ===

# Supabase PostgreSQL (Production)
# Créer un projet sur https://supabase.com
# Copier la connection string depuis Project Settings > Database > Connection Pooling
DATABASE_URL=postgresql://postgres:PASSWORD@HOST:6543/postgres

# === AUTHENTIFICATION ===

# Secret utilisé pour signer les cookies de session.
# En production, remplace-le par une chaîne aléatoire d'au moins 32 caractères.
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=change-moi-avec-une-chaine-aleatoire-de-32-caracteres-minimum

# Mot de passe attribué aux 3 comptes lors du seed initial
SEED_PASSWORD=crm2026
